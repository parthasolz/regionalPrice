{%- comment -%}
  Cookme wishlist drawer (localStorage based).
{%- endcomment -%}
<aside class="ck-wish-drawer" id="ckWishDrawer" aria-hidden="true">
  <div class="ck-drawer-bd" id="ckWishBd"></div>
  <div class="ck-drawer-panel" role="dialog" aria-modal="true" aria-label="Wishlist">
    <div class="ck-drawer-head">
      <h4>My Wishlist</h4>
      <button type="button" class="ck-drawer-close" id="ckWishClose" aria-label="Close wishlist">&times;</button>
    </div>
    <div class="ck-wish-items" id="ckWishItems"></div>
    <div class="ck-cart-empty" id="ckWishEmpty">Your wishlist is empty.</div>
  </div>
</aside>
