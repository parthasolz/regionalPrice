// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopDiscountSetting {
  id                String              @id @default(cuid())
  shop              String              @unique
  isEnabled         Boolean             @default(true)
  discountId        String?             // Shopify GID for DiscountAutomaticApp
  discountTitle     String              @default("Regional State Discount (India)")
  widgetPosition    String              @default("bottom-right") // bottom-right, bottom-left, top-bar, floating-badge
  bannerMessage     String              @default("🎉 Exclusive regional discounts available! Select your state.")
  accentColor       String              @default("#2563eb")
  rules             StateDiscountRule[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model StateDiscountRule {
  id                String              @id @default(cuid())
  shop              String
  shopSettingId     String
  shopSetting       ShopDiscountSetting @relation(fields: [shopSettingId], references: [id], onDelete: Cascade)
  stateCode         String              // e.g. WB, MH, DL, KA, TN
  stateName         String              // e.g. West Bengal, Maharashtra
  discountType      String              @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT
  discountValue     Float               @default(0) // e.g. 50.0 for 50%
  minOrderAmount    Float?              // optional minimum cart amount
  isActive          Boolean             @default(true)
  customMessage     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([shop, stateCode])
}

