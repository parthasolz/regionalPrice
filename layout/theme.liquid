    <meta charset="utf-8">
    <script>
      (function() {
        try {
          var pathname = window.location.pathname;
          var pin = localStorage.getItem('ck_pincode') || '';
          var state = localStorage.getItem('ck_pincode_state') || '';
          var outOfWb = localStorage.getItem('ck_out_of_wb');
          var isOut = false;
          if (outOfWb === 'true') {
            isOut = true;
          } else if (outOfWb === 'false') {
            isOut = false;
          } else if (pin || state) {
            if (state) {
              var s = state.trim().toLowerCase();
              if (s === 'west bengal' || s.indexOf('west bengal') !== -1 || s === 'wb') {
                isOut = false;
              } else if (s.length > 0) {
                isOut = true;
              }
            }
            if (pin) {
              var clean = String(pin).replace(/\D/g, '').slice(0, 6);
              if (clean.length === 6) {
                var p2 = clean.slice(0, 2), p3 = clean.slice(0, 3);
                if (p2 === '70' || p2 === '71' || p2 === '72') isOut = false;
                else if (p2 === '73' && p3 !== '737') isOut = false;
                else if (p2 === '74' && p3 !== '744') isOut = false;
                else isOut = true;
              }
            }
          } {%- if customer and customer.default_address -%}
          else {
            var custState = {{ customer.default_address.province | default: '' | json }};
            var custZip = {{ customer.default_address.zip | default: '' | json }};
            if (custState) {
              var cs = custState.trim().toLowerCase();
              if (cs === 'west bengal' || cs.indexOf('west bengal') !== -1 || cs === 'wb') isOut = false;
              else if (cs.length > 0) isOut = true;
            }
            if (custZip) {
              var cclean = String(custZip).replace(/\D/g, '').slice(0, 6);
              if (cclean.length === 6) {
                var cp2 = cclean.slice(0, 2), cp3 = cclean.slice(0, 3);
                if (cp2 === '70' || cp2 === '71' || cp2 === '72') isOut = false;
                else if (cp2 === '73' && cp3 !== '737') isOut = false;
                else if (cp2 === '74' && cp3 !== '744') isOut = false;
                else isOut = true;
              }
            }
          }
          {%- endif -%}
          if (isOut === true) {
            document.documentElement.classList.add('ck-loc-india');
            document.documentElement.classList.remove('ck-loc-wb');
          } else {
            document.documentElement.classList.add('ck-loc-wb');
            document.documentElement.classList.remove('ck-loc-india');
          }
          if (isOut === false) {
            if (/^\/collections\/(all|india)(\/.*)?$/i.test(pathname)) {
              var target = pathname.replace(/^\/collections\/(all|india)(?=[\/?#]|$)/i, '/collections/west-bengal') + window.location.search + window.location.hash;
              window.location.replace(target);
            }
          } else if (isOut === true) {
            if (/^\/collections\/(all|west-bengal)(\/.*)?$/i.test(pathname)) {
              var target = pathname.replace(/^\/collections\/(all|west-bengal)(?=[\/?#]|$)/i, '/collections/india') + window.location.search + window.location.hash;
              window.location.replace(target);
            }
          }
        } catch (e) {}
      })();
    </script>
