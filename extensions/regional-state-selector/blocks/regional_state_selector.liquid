{% schema %}
{
  "name": "Regional Pricing Selector",
  "target": "body",
  "stylesheet": "regional-state-selector.css",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Widget Position",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right (Floating)" },
        { "value": "bottom-left", "label": "Bottom Left (Floating)" },
        { "value": "top-bar", "label": "Top Announcement Bar" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal Title",
      "default": "Select Delivery Region (India)"
    },
    {
      "type": "text",
      "id": "modal_subtitle",
      "label": "Modal Subtitle",
      "default": "Product prices and catalog availability are updated for your delivery state."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2563eb"
    },
    {
      "type": "text",
      "id": "default_state",
      "label": "Default Delivery State",
      "default": "West Bengal"
    }
  ]
}
{% endschema %}
