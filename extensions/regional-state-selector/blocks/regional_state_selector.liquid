{% comment %}
  Regional Indian State Selector & Auto-Discount App Embed Block
{% endcomment %}

{{ 'regional-state-selector.css' | asset_url | stylesheet_tag }}

<div
  id="regional-state-widget"
  class="regional-state-widget regional-pos-{{ block.settings.position | default: 'bottom-right' }}"
  data-accent-color="{{ block.settings.accent_color | default: '#2563eb' }}"
  data-show-discounts="{{ block.settings.show_discounts | default: true }}"
  data-default-state="{{ block.settings.default_state | default: 'West Bengal' }}"
  data-banner-text="{{ block.settings.banner_text | escape }}"
>
  <!-- Floating Launcher Badge -->
  <button
    type="button"
    id="regional-state-launcher"
    class="regional-launcher-btn"
    aria-label="Select your Indian State for discounts"
    aria-expanded="false"
  >
    <span class="regional-flag-icon">🇮🇳</span>
    <span class="regional-launcher-content">
      <span class="regional-launcher-label">Delivery to:</span>
      <span class="regional-selected-state-name" id="regional-current-state-label">Select State</span>
    </span>
    <span class="regional-discount-pill" id="regional-active-pill" style="display: none;">
      <span class="regional-pill-icon">🔥</span>
      <span id="regional-pill-text">Special Discount</span>
    </span>
    <svg class="regional-chevron" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <!-- State Selection Modal / Drawer -->
  <div id="regional-modal-backdrop" class="regional-modal-backdrop" style="display: none;"></div>
  <div id="regional-state-modal" class="regional-state-modal" role="dialog" aria-modal="true" style="display: none;">
    <div class="regional-modal-header">
      <div class="regional-header-title-row">
        <span class="regional-flag-large">🇮🇳</span>
        <div>
          <h3 class="regional-modal-title">{{ block.settings.modal_title | default: 'Select Your State in India' }}</h3>
          <p class="regional-modal-subtitle">{{ block.settings.modal_subtitle | default: 'Exclusive regional discounts will auto-apply to your order at checkout.' }}</p>
        </div>
      </div>
      <button type="button" id="regional-modal-close" class="regional-modal-close-btn" aria-label="Close modal">&times;</button>
    </div>

    <!-- Active State Highlight Notice -->
    <div id="regional-discount-notice" class="regional-discount-notice" style="display: none;">
      <span class="regional-notice-icon">🎉</span>
      <div class="regional-notice-text">
        <strong id="regional-notice-title">Special offer for West Bengal!</strong>
        <p id="regional-notice-desc">50% discount will be automatically applied at checkout.</p>
      </div>
    </div>

    <!-- Search Input -->
    <div class="regional-search-wrapper">
      <svg class="regional-search-icon" viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
      </svg>
      <input
        type="text"
        id="regional-state-search"
        class="regional-state-search-input"
        placeholder="Search your state (e.g. West Bengal, Maharashtra, Delhi...)"
        autocomplete="off"
      />
    </div>

    <!-- State Selection List (Prepopulated 28 States + 8 UTs) -->
    <div class="regional-state-list-container">
      <ul id="regional-state-list" class="regional-state-list" role="listbox">
        <!-- States of India -->
        <li class="regional-state-item" data-code="WB" data-name="West Bengal" data-discount="50% OFF" role="option">
          <span class="regional-state-name">West Bengal</span>
          <span class="regional-state-badge regional-badge-hot">50% OFF 🔥</span>
        </li>
        <li class="regional-state-item" data-code="MH" data-name="Maharashtra" role="option">
          <span class="regional-state-name">Maharashtra</span>
          <span class="regional-state-badge" style="display: none;"></span>
        </li>
        <li class="regional-state-item" data-code="DL" data-name="Delhi" role="option">
