{{ 'regional-state-selector.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "State Discount Selector",
  "target": "body",
  "stylesheet": "regional-state-selector.css",
  "javascript": "regional-state-selector.js",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Widget Position",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right (Floating)" },
        { "value": "bottom-left", "label": "Bottom Left (Floating)" },
        { "value": "top-bar", "label": "Top Announcement Bar" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal Title",
      "default": "Select Your State in India"
    },
    {
      "type": "text",
      "id": "modal_subtitle",
      "label": "Modal Subtitle",
      "default": "Exclusive regional discounts will auto-apply to your order at checkout."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2563eb"
    },
    {
      "type": "checkbox",
      "id": "show_discounts",
      "label": "Show discount badges on states",
      "default": true
    }
  ]
}
{% endschema %}
